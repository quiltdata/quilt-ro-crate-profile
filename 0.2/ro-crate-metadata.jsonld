    },

    {
      "@id": "https://w3id.org/quilt/ro-crate#packageName",
      "@type": "DefinedTerm",
      "termCode": "packageName",
      "name": "package name",
      "rdfs:label": "package name",
      "description": "Identifies a PropertyValue whose value is the fully qualified name of the Quilt package to build, in the form namespace/name. Used as the value of propertyID, not as a JSON-LD key. Takes precedence over packageNamespace.",
      "rdfs:comment": "Identifies a PropertyValue whose value is the fully qualified name of the Quilt package to build, in the form namespace/name. Used as the value of propertyID, not as a JSON-LD key. Takes precedence over packageNamespace.",
      "inDefinedTermSet": { "@id": "https://w3id.org/quilt/ro-crate#" }
    },
    {
      "@id": "https://w3id.org/quilt/ro-crate#packageNamespace",
      "@type": "DefinedTerm",
      "termCode": "packageNamespace",
      "name": "package namespace",
      "rdfs:label": "package namespace",
      "description": "Identifies a PropertyValue whose value is the namespace portion only of the Quilt package name. The name portion is derived from the name of the root data entity. Used as the value of propertyID, not as a JSON-LD key.",
      "rdfs:comment": "Identifies a PropertyValue whose value is the namespace portion only of the Quilt package name. The name portion is derived from the name of the root data entity. Used as the value of propertyID, not as a JSON-LD key.",
      "inDefinedTermSet": { "@id": "https://w3id.org/quilt/ro-crate#" }
    },
    {
      "@id": "https://w3id.org/quilt/ro-crate#ELNEntry",
      "@type": ["DefinedTerm", "rdfs:Class"],
      "termCode": "ELNEntry",
      "name": "Electronic lab notebook entry",
      "rdfs:label": "Electronic lab notebook entry",
      "description": "An entry in an electronic lab notebook that documents the experiment a crate records. Used as the value of additionalType on a CreativeWork. The notebook system is identified by provider, which keeps the term independent of any one vendor.",
      "rdfs:comment": "An entry in an electronic lab notebook that documents the experiment a crate records. Used as the value of additionalType on a CreativeWork. The notebook system is identified by provider, which keeps the term independent of any one vendor.",
      "rdfs:subClassOf": { "@id": "http://schema.org/CreativeWork" },
      "inDefinedTermSet": { "@id": "https://w3id.org/quilt/ro-crate#" }
    },

