      "@id": "https://w3id.org/quilt/ro-crate/0.2",
      "@type": ["Dataset", "Profile"],
      "identifier": "https://w3id.org/quilt/ro-crate/0.2",
      "name": "Quilt RO-Crate profile",
      "description": "Profile for RO-Crates that are ingested into Quilt packages. Constrains how the target package name, the set of files to package, the responsible people and organizations, the acquiring instrument, and the originating electronic lab notebook entry are expressed, so that a packaging system can consume the crate without site-specific configuration.",
      "version": "0.2.0",
      "datePublished": "2026-09-25",
      "license": { "@id": "https://www.apache.org/licenses/LICENSE-2.0" },
      "author": { "@id": "https://quiltdata.com/" },
      "keywords": ["packaging", "provenance", "instrument data", "electronic lab notebook"],
      "isProfileOf": { "@id": "https://w3id.org/ro/crate/1.2" },
      "hasPart": [
        { "@id": "index.html" },
        { "@id": "example1/" },
        { "@id": "https://w3id.org/quilt/ro-crate#" },
        { "@id": "https://w3id.org/ro/wfrun/process/0.6" }
      ],
      "hasResource": [
        { "@id": "#hasSpecification" },
        { "@id": "#hasVocabulary" },
        { "@id": "#hasExample" },
        { "@id": "#shouldConformToProcessRun" }
      ]
    },

